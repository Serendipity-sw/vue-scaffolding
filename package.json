{
  "name": "vue-scaffolding",
  "version": "1.0.0",
  "description": "scaffolding",
  "scripts": {
    "zip": "gulp buildTime && gulp zip",
    "start": "webpack serve --progress --mode development -c ./config/webpack/webpack.dev.js",
    "analyze": "webpack --progress --mode production -c ./config/webpack/webpack.analyze.js",
    "build-develop-fix": "webpack --progress --mode production -c ./config/webpack/webpack.dev.js",
    "build-release": "webpack --progress --mode production -c ./config/webpack/webpack.release.js",
    "build": "webpack --progress --mode production -c ./config/webpack/webpack.product.js",
    "build-develop-fix:zip": "yarn run build-develop-fix && yarn run zip",
    "build-release:zip": "yarn run build-release && yarn run zip",
    "build:zip": "yarn run build && yarn run zip",
    "format": "prettier --write ./src",
    "lint": "eslint src/**/*.{js,vue,ts,jsx,tsx} --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swgloomy/react-scaffolding.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swgloomy/vue-scaffolding/issues"
  },
  "homepage": "https://github.com/swgloomy/vue-scaffolding#readme",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vue/babel-plugin-jsx": "^1.4.0",
    "@vue/compiler-sfc": "^3.5.13",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cssnano": "^7.0.6",
    "cssnano-preset-advanced": "^7.0.6",
    "file-loader": "^6.2.0",
    "gulp": "^5.0.0",
    "gulp-zip": "^6.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "portfinder-sync": "^0.0.2",
    "postcss": "^8.5.3",
    "postcss-advanced-variables": "^5.0.0",
    "postcss-assets": "^6.0.0",
    "postcss-atroot": "^0.2.4",
    "postcss-import": "^16.1.0",
    "postcss-initial": "^3.0.4",
    "postcss-loader": "^8.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.1.5",
    "postcss-property-lookup": "^3.0.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-use": "^3.0.0",
    "postcss-utilities": "^0.8.4",
